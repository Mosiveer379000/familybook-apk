<?xml version="1.0" encoding="utf-8"?>
<!-- Add Family: একাধিক নামের সারি (Sisters / Brother / Spouse / Child)
     লেবেল + সংখ্যা + নাম ইনপুট + ডট + Add + লক, নিচে যোগ করা নামের চিপ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtLabel"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="Sister"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text=":"
            android:textColor="#888888"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- নাম যোগ হলে নিজে নিজে সংখ্যা বদলায়; হাতে লেখা যায় না -->
        <EditText
            android:id="@+id/edtCount"
            android:layout_width="34dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_edittext"
            android:cursorVisible="false"
            android:focusable="false"
            android:gravity="center"
            android:inputType="none"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtInput"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#000000"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="status"
            android:src="@drawable/ic_red_dot" />

        <ImageView
            android:id="@+id/btnAddChip"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Add"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add_chip" />

        <ImageView
            android:id="@+id/imgLock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="privacy"
            android:src="@drawable/ic_fam_lock" />
    </LinearLayout>

    <com.familybook.app.FlowLayout
        android:id="@+id/flowChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>
