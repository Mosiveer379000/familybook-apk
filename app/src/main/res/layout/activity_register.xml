<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/ic_log_reg" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="4dp"
            android:background="#C8C8C8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="SignUp :"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ইন্ট্রো লেখা (ধাপ ১-৪ এ দেখায়, রিভিউতে লুকানো) -->
        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="#111111"
            android:textSize="11sp" />

        <com.familybook.app.StepperView
            android:id="@+id/stepper"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="2dp" />

        <!-- ================= ধাপ ১ : Name ================= -->
        <LinearLayout
            android:id="@+id/panelStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <!-- Full Name -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Full Name" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etName"
                        style="@style/WizBox"
                        android:inputType="textPersonName|textCapWords" />
                    <TextView
                        style="@style/WizHint"
                        android:text="Hint : If NID Match Name will be verified" />
                </LinearLayout>
                <TextView android:id="@+id/starName" style="@style/WizStar" />
            </LinearLayout>

            <!-- Nationality -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Nationality" />
                <TextView style="@style/WizColon" />
                <com.familybook.app.PlainEditText
                    android:id="@+id/etNation"
                    style="@style/WizBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:inputType="textCapWords" />
                <TextView android:id="@+id/starNation" style="@style/WizStar" />
            </LinearLayout>

            <!-- Gender -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Gender" />
                <TextView style="@style/WizColon" />
                <TextView
                    android:id="@+id/tvGender"
                    style="@style/WizBox"
                    android:layout_width="96dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="Select" />
                <TextView android:id="@+id/starGender" style="@style/WizStar" />
            </LinearLayout>

            <!-- Blood (optional) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Blood" />
                <TextView style="@style/WizColon" />
                <TextView
                    android:id="@+id/tvBlood"
                    style="@style/WizBox"
                    android:layout_width="96dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="Select" />
                <TextView style="@style/WizOptional" />
            </LinearLayout>

            <!-- NID / BRC (optional) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="NID /BRC" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUpload"
                        style="@style/WizButton"
                        android:layout_width="match_parent"
                        android:minHeight="44dp"
                        android:background="@drawable/bg_wiz_upload"
                        android:text="Upload BRC or NID" />
                    <TextView
                        style="@style/WizHint"
                        android:gravity="center"
                        android:text="All Fields become green, after verification is complete."
                        android:textColor="#555555"
                        android:textStyle="normal" />
                </LinearLayout>
                <TextView style="@style/WizOptional" />
            </LinearLayout>

            <!-- Birthday -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Birthday" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etDay"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="DD"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etMonth"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="MM"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etYear"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.4"
                            android:gravity="center"
                            android:hint="YYYY"
                            android:inputType="number"
                            android:maxLength="4"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                    </LinearLayout>
                    <TextView
                        style="@style/WizHint"
                        android:gravity="center"
                        android:text="Birthday become green after NID/BRC verified." />
                </LinearLayout>
                <TextView android:id="@+id/starDob" style="@style/WizStar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= ধাপ ২ : Contacts ================= -->
        <LinearLayout
            android:id="@+id/panelStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <!-- Primary Email -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Primary Email" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etEmail"
                        style="@style/WizBox"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                    <TextView
                        android:id="@+id/tvEmailHint"
                        style="@style/WizHint"
                        android:text="One Email for One Account" />
                </LinearLayout>
                <TextView android:id="@+id/starEmail" style="@style/WizStar" />
            </LinearLayout>

            <!-- Phone Number -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Phone Number" />
                <TextView style="@style/WizColon" />
                <com.familybook.app.PlainEditText
                    android:id="@+id/etPhone"
                    style="@style/WizBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:autofillHints="phone"
                    android:inputType="phone"
                    android:maxLength="16" />
                <TextView android:id="@+id/starPhone" style="@style/WizStar" />
            </LinearLayout>

            <!-- AGU Number : username + অটো নম্বর (কালো ঘর) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="AGU Number" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etAgu"
                            style="@style/WizBox"
                            android:layout_width="96dp"
                            android:inputType="textNoSuggestions|textVisiblePassword"
                            android:maxLength="8" />
                        <TextView
                            android:id="@+id/tvAguNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:minHeight="44dp"
                            android:background="#000000"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="---"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAguHint"
                        style="@style/WizHint"
                        android:textColor="#555555"
                        android:textStyle="normal" />
                </LinearLayout>
                <TextView android:id="@+id/starAgu" style="@style/WizStar" />
            </LinearLayout>

            <!-- NID/BRC Name : NID/BRC ভেরিফাই হলে নিজে নিজে বসবে -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="NID/BRC Name" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etNidName"
                        style="@style/WizBox"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                    <TextView
                        style="@style/WizHint"
                        android:text="Auto Filed up After NID/BRC Uploaded &amp; Verified Successfully."
                        android:textColor="#555555"
                        android:textStyle="normal" />
                </LinearLayout>
                <TextView android:id="@+id/starNidName" style="@style/WizStar" />
            </LinearLayout>

            <!-- Strong Password + নিয়মের তালিকা -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Strong Password" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etPassword"
                        style="@style/WizBox"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword" />
                    <TextView
                        android:id="@+id/tvPassRules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="6dp"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView android:id="@+id/starPass" style="@style/WizStar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= ধাপ ৩ : Verify ================= -->
        <LinearLayout
            android:id="@+id/panelVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                style="@style/WizHeading"
                android:layout_marginTop="14dp"
                android:text="Verification :" />

            <TextView
                android:id="@+id/tvVerifyInfo"
                style="@style/WizInfo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/otpRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp0"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp1"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp2"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp3"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp4"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp5"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp6"
                        style="@style/WizOtp" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/otp7"
                        style="@style/WizOtp" />
                </LinearLayout>
                <TextView android:id="@+id/starOtp" style="@style/WizStar" />
            </LinearLayout>

            <TextView
                style="@style/WizHeading"
                android:layout_marginTop="34dp"
                android:text="Password :" />

            <TextView
                android:id="@+id/tvVerPassInfo"
                style="@style/WizInfo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.familybook.app.PlainEditText
                    android:id="@+id/etVerPass"
                    style="@style/WizBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:inputType="textPassword" />
                <TextView android:id="@+id/starVerPass" style="@style/WizStar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= ধাপ ৪ : City (ঐচ্ছিক) ================= -->
        <LinearLayout
            android:id="@+id/panelCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/WizHeading"
                android:text="Current City" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(Optional)"
                    android:textColor="#777777"
                    android:textSize="11sp" />
            </LinearLayout>
            <com.familybook.app.PlainEditText
                android:id="@+id/etCity"
                style="@style/WizBox"
                android:layout_marginTop="6dp"
                android:inputType="textCapWords" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/WizHeading"
                android:text="Hometown" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(Optional)"
                    android:textColor="#777777"
                    android:textSize="11sp" />
            </LinearLayout>
            <com.familybook.app.PlainEditText
                android:id="@+id/etHome"
                style="@style/WizBox"
                android:layout_marginTop="6dp"
                android:inputType="textCapWords" />
        </LinearLayout>

        <!-- ================= ধাপ ৫ : Review ================= -->
        <LinearLayout
            android:id="@+id/panelReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/reviewHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_review_card"
                android:orientation="vertical"
                android:padding="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#444444"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I'am agree with 'terms &amp; Conditions'"
                    android:textColor="#444444"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/btnSubmit"
                    style="@style/WizButton"
                    android:minWidth="90dp"
                    android:background="@drawable/bg_wiz_next"
                    android:text="Register" />
            </LinearLayout>
        </LinearLayout>

        <!-- Back / Next -->
        <RelativeLayout
            android:id="@+id/navRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">
            <TextView
                android:id="@+id/btnBack"
                style="@style/WizButton"
                android:background="@drawable/bg_wiz_back"
                android:text="Back" />
            <TextView
                android:id="@+id/btnSkip"
                style="@style/WizButton"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/btnNext"
                android:textColor="#0A66FF"
                android:visibility="gone"
                android:background="@drawable/bg_wiz_skip"
                android:text="Skip" />
            <TextView
                android:id="@+id/btnNext"
                style="@style/WizButton"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_wiz_next"
                android:text="Next" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <LinearLayout
            android:id="@+id/footerLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

        <!-- or + login -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.04"
            android:text="Do you have any account before?"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="Simply just "
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.04"
                android:text="login Here"
                android:textColor="#0A66FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
