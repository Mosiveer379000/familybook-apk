<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/ic_log_reg" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="8dp"
            android:background="#C8C8C8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="SignUp :"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ইন্ট্রো লেখা (ধাপ ১-৪ এ দেখায়, রিভিউতে লুকানো) -->
        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="#111111"
            android:textSize="14sp" />

        <com.familybook.app.StepperView
            android:id="@+id/stepper"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp" />

        <!-- ================= ধাপ ১ : Name ================= -->
        <LinearLayout
            android:id="@+id/panelStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <!-- Full Name -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Full Name" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etName"
                        style="@style/WizBox"
                        android:inputType="textPersonName|textCapWords" />
                    <TextView
                        style="@style/WizHint"
                        android:layout_marginStart="8dp"
                        android:text="Hint : If NID Match Name will be verified" />
                </LinearLayout>
                <TextView android:id="@+id/starName" style="@style/WizStar" />
            </LinearLayout>

            <!-- Nationality -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Nationality" />
                <TextView style="@style/WizColon" />
                <com.familybook.app.PlainEditText
                    android:id="@+id/etNation"
                    style="@style/WizBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:inputType="textCapWords" />
                <TextView android:id="@+id/starNation" style="@style/WizStar" />
            </LinearLayout>

            <!-- Gender -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Gender" />
                <TextView style="@style/WizColon" />
                <TextView
                    android:id="@+id/tvGender"
                    style="@style/WizBox"
                    android:layout_width="96dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="Select" />
                <TextView android:id="@+id/starGender" style="@style/WizStar" />
            </LinearLayout>

            <!-- Blood (optional) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Blood" />
                <TextView style="@style/WizColon" />
                <TextView
                    android:id="@+id/tvBlood"
                    style="@style/WizBox"
                    android:layout_width="96dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="Select" />
                <TextView style="@style/WizOptional" />
            </LinearLayout>

            <!-- NID / BRC (optional) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="NID /BRC" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUpload"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wiz_upload"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Upload BRC or NID"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="All Fields become green, after verification is complete."
                        android:textColor="#555555"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView style="@style/WizOptional" />
            </LinearLayout>

            <!-- Birthday -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Birthday" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etDay"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="DD"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etMonth"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="MM"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                        <com.familybook.app.PlainEditText
                            android:id="@+id/etYear"
                            style="@style/WizBox"
                            android:layout_width="0dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.4"
                            android:gravity="center"
                            android:hint="YYYY"
                            android:inputType="number"
                            android:maxLength="4"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Birthday become green after NID/BRC verified."
                        android:textColor="#333333"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/starDob" style="@style/WizStar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ অস্থায়ী ধাপ ২ : পুরনো Email/Phone/Password ফর্ম ============
             (পরের ধাপে এটা নতুন Contacts ডিজাইনে বদলে যাবে) -->
        <LinearLayout
            android:id="@+id/panelTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <!-- Email -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Email" />
                <TextView style="@style/WizColon" />
                <com.familybook.app.PlainEditText
                    android:id="@+id/etEmail"
                    style="@style/WizBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />
                <TextView android:id="@+id/starEmail" style="@style/WizStar" />
            </LinearLayout>

            <!-- Phone (optional) -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Phone" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wiz_field"
                    android:gravity="center_vertical"
                    android:padding="2dp">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_reg_grey"
                        android:gravity="center"
                        android:text="+880"
                        android:textColor="#555555"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="1XXXXXXXXX (optional)"
                        android:inputType="number"
                        android:maxLength="11"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#222222"
                        android:textColorHint="#BDBDBD"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/starPhone" style="@style/WizStar" />
            </LinearLayout>

            <!-- Password -->
            <LinearLayout style="@style/WizRow">
                <TextView style="@style/WizLabel" android:text="Password" />
                <TextView style="@style/WizColon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wiz_field"
                    android:gravity="center_vertical"
                    android:padding="2dp">
                    <com.familybook.app.PlainEditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autofillHints="newPassword"
                        android:background="@null"
                        android:hint="example@ : masuD379#"
                        android:inputType="textPassword"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#222222"
                        android:textColorHint="#BDBDBD"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvTogglePass"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="#888888"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="SHOW"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/starPass" style="@style/WizStar" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPassRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="118dp"
                android:layout_marginTop="8dp"
                android:textSize="10sp" />

            <!-- Terms + Submit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#0A66FF"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I'am agree with 'terms &amp; Conditions'"
                    android:textColor="#444444"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/btnSubmit"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_wiz_next"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Submit"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Back / Next -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:paddingStart="6dp"
            android:paddingEnd="26dp">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wiz_back"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="54dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Back"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_wiz_next"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="54dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Next"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- or + login -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="or"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.04"
            android:text="Do you have any account before?"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="Simply just "
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.04"
                android:text="login Here"
                android:textColor="#0A66FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
