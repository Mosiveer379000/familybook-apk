<?xml version="1.0" encoding="utf-8"?>
<!-- Add Languages page: proportions copied from the design mockup (reference width = 360dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLang"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- header: back arrow + icon + title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/btnBackLang"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_back_left" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Languages"
                android:src="@drawable/ic_languages" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Add Languages"
                android:textColor="#050505"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="45dp"
            android:paddingEnd="45dp">

            <!-- rounded gray box (270 x 143dp): chips on top, input at the bottom -->
            <LinearLayout
                android:id="@+id/boxLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="143dp"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingTop="6dp"
                android:paddingEnd="7dp"
                android:paddingBottom="10dp">

                <com.familybook.app.FlowLayout
                    android:id="@+id/flowLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/etLang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_input"
                        android:hint="Add multiple language you know"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLength="30"
                        android:paddingStart="0dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:textColor="#050505"
                        android:textColorHint="#9AA0A6"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnLangAdd"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="14dp"
                        android:clickable="true"
                        android:contentDescription="Add"
                        android:focusable="true"
                        android:src="@drawable/ic_search"
                        android:tint="#8A8D91" />
                </LinearLayout>
            </LinearLayout>

            <!-- suggestions -->
            <LinearLayout
                android:id="@+id/llLangSuggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Pivracy -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pivracy :"
                    android:textColor="#050505"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivPrivLang"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:contentDescription="Privacy"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Save (256 x 26dp) -->
            <TextView
                android:id="@+id/btnSaveLang"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_pi_save_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- thin divider under Save, like the mockup -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="2dp"
                android:background="#C4C7CB" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
