<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_gp_avatar">

        <ImageView
            android:id="@+id/imgGroupLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:contentDescription="Group"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tm_groups" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAdmin"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_gp_admin"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGroupSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#65676B"
                android:textSize="15sp" />

            <View
                android:id="@+id/dotNew"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gp_dot"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnPin"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:contentDescription="Pin group"
        android:src="@drawable/ic_gp_pin" />
</LinearLayout>
