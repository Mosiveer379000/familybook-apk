<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:contentDescription="Close"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/close_x" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_add_family" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add Family"
                android:textColor="#2E3033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Verified / Not verified ব্যাজ: টাইটেলের গায়ে লাগানো -->
            <TextView
                android:id="@+id/imgNotVerifiedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge_not_verified"
                android:contentDescription="verification status"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Not verified"
                android:textColor="#FF7171"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

</RelativeLayout>

    <!-- Main Border Container -->
    <LinearLayout
        android:id="@+id/layoutContainerBorder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gray_border"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Father -->
        <include
            android:id="@+id/rowFather"
            layout="@layout/item_family_row" />

        <!-- Mother -->
        <include
            android:id="@+id/rowMother"
            layout="@layout/item_family_row" />

        <!-- Sisters -->
        <include
            android:id="@+id/rowSisters"
            layout="@layout/item_family_row_split" />

        <!-- Brother -->
        <include
            android:id="@+id/rowBrother"
            layout="@layout/item_family_row_split" />

        <!-- Spouse -->
        <include
            android:id="@+id/rowSpouse"
            layout="@layout/item_family_row_split" />

        <!-- Child -->
        <include
            android:id="@+id/rowChild"
            layout="@layout/item_family_row_split" />

    </LinearLayout>

    <!-- Note Text -->
    <TextView
        android:id="@+id/txtNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="[ Note : Upload 4 Files to Get verified ]"
        android:textColor="#888888"
        android:textSize="11sp" />

    <!-- Upload Document Buttons (F, M, S, C) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnUploadF"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="#555555"
            android:gravity="center"
            android:text="F"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnUploadM"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="#555555"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnUploadS"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="#333333"
            android:gravity="center"
            android:text="S"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnUploadC"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="#555555"
            android:gravity="center"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/verificationProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Action Buttons (Reset, Verify, Submit) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/btnReset"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reset" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVerify"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_verify_btn" />

            <ImageView
                android:id="@+id/btnSubmit"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fam_submit_off" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
</ScrollView>
