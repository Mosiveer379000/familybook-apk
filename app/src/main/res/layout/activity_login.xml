<?xml version="1.0" encoding="utf-8"?>
<!--
  Login: both screens live in this one layout.
  panelSaved = saved profiles screen (image 1), panelForm = login form screen (image 2).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Back arrow row (login form screen only) -->
            <FrameLayout
                android:id="@+id/backRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_login_back"
                    android:contentDescription="Back"
                    android:padding="9dp"
                    android:src="@drawable/ic_login_back" />
            </FrameLayout>

            <!-- Language selector (centered) + three dots (saved profiles screen only) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp">

                <LinearLayout
                    android:id="@+id/langRow"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English (US)"
                        android:textColor="#000000"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_login_caret" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnDots"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="10dp"
                    android:src="@drawable/ic_login_dots" />
            </FrameLayout>

            <!-- FamilyBook logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="FamilyBook"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_log_reg" />

            <!-- ================= Screen 1 : saved profiles ================= -->
            <LinearLayout
                android:id="@+id/panelSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="44dp"
                android:paddingEnd="28dp">

                <LinearLayout
                    android:id="@+id/cardList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnUseAnother"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Use another profile"
                    android:textColor="#0A66FF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= Screen 2 : login form ================= -->
            <LinearLayout
                android:id="@+id/panelForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="70dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <com.familybook.app.PlainEditText
                    android:id="@+id/etLoginId"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_login_field"
                    android:hint="Email, AGU, NID/BRC"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textColorHint="#444444"
                    android:textSize="18sp" />

                <com.familybook.app.PlainEditText
                    android:id="@+id/etLoginPass"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="11dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_login_field"
                    android:hint="Password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:singleLine="true"
                    android:textColor="#000000"
                    android:textColorHint="#444444"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnSign"
                    android:layout_width="200dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_sign"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Sign in"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Forgot password: demo for now, blue + bold link style -->
                <TextView
                    android:id="@+id/tvForgot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Forgot password ?"
                    android:textColor="#0A66FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- pushes the bottom block down -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Register as new (both screens) -->
            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_login_register"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Register as new"
                android:textColor="#0A66FF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- round FamilyBook logo + "family" (login form screen only) -->
            <LinearLayout
                android:id="@+id/footerLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_login_logo_circle"
                    android:clipToOutline="true"
                    android:contentDescription="FamilyBook"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_familybook_new" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:text="family"
                    android:textColor="#0A66FF"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />
        </LinearLayout>
    </ScrollView>

    <!-- loading overlay -->
    <FrameLayout
        android:id="@+id/loginLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
