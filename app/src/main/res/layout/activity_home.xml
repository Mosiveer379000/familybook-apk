<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h_bg"
    android:orientation="vertical">

    <!-- হেডার: family logo | + / সার্চ / মেসেঞ্জার -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="41dp"
            android:adjustViewBounds="true"
            android:contentDescription="Family Logo"
            android:src="@drawable/ic_family_header"
            android:tint="@color/h_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnAddPost"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New post"
            android:padding="4dp"
            android:src="@drawable/ic_h_plus_circle"
            android:tint="@color/h_plus" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:padding="4dp"
            android:src="@drawable/ic_h_search"
            android:tint="@color/h_icon" />

        <ImageView
            android:id="@+id/btnMessenger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Messages"
            android:padding="4dp"
            android:src="@drawable/ic_h_messenger"
            android:tint="@color/h_icon" />
    </LinearLayout>

    <!-- প্রোফাইল ছবি + পিল (বক্স একটু বড়) + গ্যালারি আইকন -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/imgMyAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_h_ring"
            android:padding="3dp"
            android:src="@drawable/ic_profile" />

        <TextView
            android:id="@+id/tvWhatsOnMind"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_h_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:text="&quot;Say whats Good!.&quot;"
            android:textColor="@color/h_text"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/btnPostImage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Gallery"
            android:padding="7dp"
            android:src="@drawable/cam_gallery"
            android:tint="@color/h_gallery" />

    </LinearLayout>

    <!-- Memory (স্টোরি) সারি -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/memRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cardCreateMemory"
                android:layout_width="104dp"
                android:layout_height="175dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_mem_card_round"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true">

                <!-- ১. ব্যাকগ্রাউন্ডে ইউজারের নিজের ছবি (HomeActivity-তে AvatarLoader দিয়ে রানটাইমে বসে) -->
                <ImageView
                    android:id="@+id/ivMyProfileBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_mem_placeholder" />

                <!-- লেখার নিচে হালকা শেড (যাতে টেক্সট স্পষ্ট দেখা যায়) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_mem_shade" />

                <!-- ২. একদম মাঝখানে সাদা বৃত্তের ভেতরে নীল প্লাস (+) আইকন -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/ivCreatePlusIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_h_create_plus"
                        app:tint="#0055FE" />
                </FrameLayout>

                <!-- ৩. একদম নিচে সাদা রঙের "Add memory" টেক্সট -->
                <TextView
                    android:id="@+id/tvAddMemory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="Add memory"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/divPostFeed"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@color/h_divider" />

    <!-- পোস্ট ফিড -->
    <com.familybook.app.PullRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </com.familybook.app.PullRefreshLayout>

    <!-- নিচের বার: Home · Shorts · ClayStore · Notification · Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/h_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:src="@drawable/ic_h_home"
            android:tint="@color/h_nav_active" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/navGallery"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Shorts"
                android:src="@drawable/ic_shorts_logo"
                android:tint="@color/h_icon" />

            <View
                android:id="@+id/navShortsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/dot_red"
                android:visibility="gone" />
        </FrameLayout>

        <!-- আগের Marketplace/Shop: এখন ClayStore -->
        <FrameLayout
            android:id="@+id/navShopWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true">

            <ImageView
                android:id="@+id/navShop"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="ClayStore"
                android:src="@drawable/marketplace"
                android:tint="@color/h_icon" />

            <!-- আপডেট সংখ্যার লাল ডট: আইকনের গায়ে লাগানো, ওপরে কাটে না -->
            <TextView
                android:id="@+id/navShopBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navNotif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNotifIcon"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_h_bell"
                android:tint="@color/h_icon" />

            <TextView
                android:id="@+id/navBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgNavAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_h_ring"
                android:padding="2dp"
                android:src="@drawable/ic_profile" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
