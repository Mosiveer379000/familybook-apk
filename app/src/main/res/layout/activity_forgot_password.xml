<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- header: logo + close -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="10dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="FamilyBook"
                    android:src="@drawable/ic_log_reg" />

                <ImageView
                    android:id="@+id/fpClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:padding="10dp"
                    android:src="@drawable/ic_fp_close" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="#C8C8C8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forget Password ?"
                    android:textColor="#000000"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fpIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="#444444"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Choose Method :"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- method dropdown -->
                <LinearLayout
                    android:id="@+id/fpMethodBox"
                    android:layout_width="180dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_fp_method"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/fpMethodText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Email"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_fp_method"
                        android:padding="3dp"
                        android:src="@drawable/ic_fp_caret" />
                </LinearLayout>

                <!-- ============ EMAIL: enter email ============ -->
                <LinearLayout
                    android:id="@+id/panelEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter your primary email :"
                        android:textColor="#444444"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <com.familybook.app.PlainEditText
                        android:id="@+id/etFpEmail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="emailAddress"
                        android:background="@drawable/bg_fp_input"
                        android:inputType="textEmailAddress|textNoSuggestions"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEmailExpire"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:textColor="#444444"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSendCode"
                            style="@style/FpPill"
                            android:text="Sent Code" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ AGU: find ============ -->
                <LinearLayout
                    android:id="@+id/panelAgu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_fp_findrow"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_fp_search" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Find AGU"
                            android:textColor="#444444"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.familybook.app.PlainEditText
                            android:id="@+id/etFpAgu"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_fp_input"
                            android:inputType="textNoSuggestions"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:singleLine="true"
                            android:textColor="#444444"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fpAguList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="120dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_fp_list"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnAguSelect"
                        style="@style/FpPill"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="Select" />
                </LinearLayout>

                <!-- ============ NID / BRC: number + verify ============ -->
                <LinearLayout
                    android:id="@+id/panelNid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNidLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="10 Digits NID no:"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.familybook.app.PlainEditText
                            android:id="@+id/etFpNid"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_fp_input_blue"
                            android:digits="0123456789"
                            android:inputType="number"
                            android:letterSpacing="0.2"
                            android:maxLength="17"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#444444"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnNidVerify"
                            style="@style/FpPill"
                            android:layout_marginStart="8dp"
                            android:text="Verify" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNidName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:paddingStart="4dp"
                        android:textColor="#444444"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ============ code ============ -->
                <LinearLayout
                    android:id="@+id/panelCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCodeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:textColor="#444444"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.familybook.app.PlainEditText
                        android:id="@+id/etFpCode"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_fp_input"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:inputType="number"
                        android:letterSpacing="0.25"
                        android:maxLength="8"
                        android:singleLine="true"
                        android:textColor="#000000"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCodeExpire"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:textColor="#444444"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnCodeSubmit"
                            style="@style/FpPill"
                            android:text="Submit" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ new password ============ -->
                <LinearLayout
                    android:id="@+id/panelNewPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:text="New Password"
                            android:textColor="#444444"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.familybook.app.PlainEditText
                            android:id="@+id/etFpNew"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:autofillHints="newPassword"
                            android:background="@drawable/bg_fp_input_blue"
                            android:inputType="textPassword"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="112dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:text="Re-enter"
                            android:textColor="#444444"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.familybook.app.PlainEditText
                            android:id="@+id/etFpRe"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:autofillHints="newPassword"
                            android:background="@drawable/bg_fp_input_blue"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnFpSave"
                        style="@style/FpPill"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:text="Save" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFpMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="4dp"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/fpLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
