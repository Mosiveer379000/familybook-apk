<?xml version="1.0" encoding="utf-8"?>
<!-- Menu পেজ: উপরে HTML (WebView), নিচে আগের মতই নেটিভ Bottom Navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h_bg"
    android:orientation="vertical">

    <!-- assets/familybook_menu.html এখানে চলে -->
    <WebView
        android:id="@+id/webMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- নিচের নেভিগেশন (Home · Shorts · Shop · Notification · Profile) -->
    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
