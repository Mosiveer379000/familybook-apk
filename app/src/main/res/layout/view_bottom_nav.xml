<?xml version="1.0" encoding="utf-8"?>
<!-- সব স্ক্রিনের নিচের নেভিগেশন (Home এর মতই): Home · Gallery · Shop · Dashboard · Profile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E6EB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bnHome"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:src="@drawable/ic_h_home"
            android:tint="@color/h_icon" />

        <ImageView
            android:id="@+id/bnGallery"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="My posts"
            android:src="@drawable/ic_shorts_logo"
            android:tint="@color/h_icon" />

        <ImageView
            android:id="@+id/bnShop"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Shop"
            android:src="@drawable/marketplace"
            android:tint="@color/h_icon" />

        <ImageView
            android:id="@+id/bnDash"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Dashboard"
            android:src="@drawable/ic_h_dash"
            android:tint="@color/h_icon" />

        <FrameLayout
            android:id="@+id/bnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bnAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_h_ring"
                android:padding="2dp"
                android:src="@drawable/ic_profile" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
