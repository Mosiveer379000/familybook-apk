<?xml version="1.0" encoding="utf-8"?>
<!-- সব স্ক্রিনের নিচের নেভিগেশন (Home এর মতই): Home · Gallery · Shop · Notification · Profile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E6EB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bnHome"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:src="@drawable/ic_h_home"
            android:tint="@color/h_icon" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bnGallery"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Shorts"
                android:src="@drawable/ic_shorts_logo"
                android:tint="@color/h_icon" />

            <View
                android:id="@+id/bnShortsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/dot_red"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/bnShop"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="Shop"
            android:src="@drawable/marketplace"
            android:tint="@color/h_icon" />

        <FrameLayout
            android:id="@+id/bnNotif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_h_bell"
                android:tint="@color/h_icon" />

            <TextView
                android:id="@+id/bnBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/bnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bnAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_h_ring"
                android:padding="2dp"
                android:src="@drawable/ic_profile" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
