<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- উপরের বার: বামে ব্যাক, ডানে সার্চ (সার্চ চাপলে এখানেই সার্চ বক্স খোলে) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_gp_back" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_gp_search" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_gp_compose"
            android:hint="Search in this group"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111111"
            android:textColorHint="#8A8D91"
            android:textSize="15sp"
            android:visibility="gone" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- কভার ফটো + ক্যামেরা আইকন (শুধু অ্যাডমিন) -->
            <FrameLayout
                android:id="@+id/coverFrame"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_gp_cover_empty">

                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Cover photo"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/btnCoverCamera"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:contentDescription="Change cover"
                    android:padding="5dp"
                    android:src="@drawable/ic_fb_cover_camera"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- কভারের নিচে: বামে Created by, ডানে Creation time -->
            <LinearLayout
                android:id="@+id/createdBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#333333"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvCreated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCreatedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- গ্রুপের নাম + ডানে তীর -->
            <LinearLayout
                android:id="@+id/nameRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#111111"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnGroupInfo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Group info"
                    android:padding="6dp"
                    android:src="@drawable/ic_gp_arrow_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="2dp"
                android:paddingEnd="16dp"
                android:textColor="#8A8D91"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/imgPrivacy"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_globe" />

                <TextView
                    android:id="@+id/tvPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#65676B"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Manage | Join | Invite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp">

                <!-- Manage + নতুন অ্যাপ্রুভাল থাকলে উপরের কোণে লাল ডট -->
                <FrameLayout
                    android:id="@+id/manageWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <com.familybook.app.GroupIconButton
                        android:id="@+id/btnManage"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_gp_btn_manage"
                        android:drawableStart="@drawable/ic_gp_gear_btn"
                        android:drawablePadding="6dp"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Manage"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <View
                        android:id="@+id/manageDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/bg_gp_badge_red"
                        android:visibility="gone" />
                </FrameLayout>

                <com.familybook.app.GroupIconButton
                    android:id="@+id/btnJoin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gp_btn_join"
                    android:drawableStart="@drawable/ic_gp_plus_btn"
                    android:drawablePadding="6dp"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Join"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.familybook.app.GroupIconButton
                    android:id="@+id/btnInvite"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gp_btn_invite"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Invite"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- All | Photos | Videos | Status | You | Description (জায়গা না হলে পাশে স্ক্রল হয়) -->
            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="9dp">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Photos"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Videos"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Status"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabYou"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="You"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- পোস্ট বক্স (শুধু সদস্যদের জন্য) -->
            <LinearLayout
                android:id="@+id/composeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgMe"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gp_compose_ring"
                        android:padding="3dp" />

                    <!-- হোমের মতো: চাপলে পূর্ণ পোস্ট স্ক্রিন খোলে -->
                    <TextView
                        android:id="@+id/tvPostHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gp_compose"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:text="Say good or keep silence"
                        android:textColor="#65676B"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/btnPickPhoto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Add photo"
                        android:padding="6dp"
                        android:src="@drawable/cam_gallery"
                        android:tint="@color/h_icon" />

                    <ImageView
                        android:id="@+id/btnPickVideo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Add video (demo)"
                        android:padding="6dp"
                        android:src="@drawable/ic_gp_video" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:background="#E4E6EB" />

            <!-- সার্চে মিলে যাওয়া সদস্য -->
            <LinearLayout
                android:id="@+id/membersBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="#65676B"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- সদস্যদের পোস্ট -->
            <LinearLayout
                android:id="@+id/postsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
