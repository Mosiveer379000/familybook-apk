<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- নিচের ঝাপসা ছবি -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_bottom_banner" />

    <!-- ডানের নীল কার্ভ (ছবির উপরে) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_blue_wave" />

    <!-- ডানে-উপরে Current version -->
    <TextView
        android:id="@+id/tvCurrentVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:text="Current version: v1.0"
        android:textColor="#8DB0FF"
        android:textSize="11dp"
        android:textStyle="bold" />

    <!-- ব্যাকগ্রাউন্ডে ইনস্টল চলছে: নিচের ছবির জায়গায় ছোট spinner -->
    <LinearLayout
        android:id="@+id/layoutInstalling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_installing_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressInstalling"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#0B5CFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Installing..."
            android:textColor="#0B5CFF"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- STATE 1 + STATE 2 -->
    <LinearLayout
        android:id="@+id/contentUpdate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <ImageView
            android:layout_width="218dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/update_header" />

        <LinearLayout
            android:id="@+id/layoutPlayStore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_playstore" />

            <TextView
                android:id="@+id/tvPlayStoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Update from playstore"
                android:textColor="#444444"
                android:textSize="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutUpdateHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:paddingEnd="80dp">

            <TextView
                android:id="@+id/tvNewUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="🔥 New Update!"
                android:textColor="#111111"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNewUpdateBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:layout_marginTop="2dp"
                android:lineSpacingMultiplier="0.88"
                android:text="There is a new version of FamilyBook.\nupdate it to enjoy new futures."
                android:textColor="#111111"
                android:textSize="11dp" />

            <TextView
                android:id="@+id/tvWhatsNewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="64dp"
                android:text="✳️ Whats New?"
                android:textColor="#111111"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWhatsNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#757575"
                android:textSize="11dp" />
        </LinearLayout>

        <!-- STATE 2: progress (Update now চাপলে) -->
        <LinearLayout
            android:id="@+id/layoutProgressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="60dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUpdatingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updating..."
                android:textColor="#0B5CFF"
                android:textSize="16dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressBarUpdate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_blue" />

                <TextView
                    android:id="@+id/tvProgressPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0%"
                    android:textColor="#0B5CFF"
                    android:textSize="11dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATE 1: Later + Update now -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="165dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLater"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_later_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="Later"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12dp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnUpdateNow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_update_now_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="Update now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- STATE 3: Congratulations -->
    <LinearLayout
        android:id="@+id/contentSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="218dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/update_header" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="38dp"
            android:paddingEnd="80dp">

            <TextView
                android:id="@+id/tvCongrats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Congratulations! 🔥"
                android:textColor="#00A82D"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="familybook updated successfully"
                android:textColor="#555555"
                android:textSize="11dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.05"
                android:text="Update Completed!"
                android:textColor="#00A82D"
                android:textSize="11dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressBarDone"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/progress_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="100%"
                    android:textColor="#00A82D"
                    android:textSize="10dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGoToFeed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_go_feed_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:stateListAnimator="@null"
                    android:text="Go to feed"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="(5)"
                    android:textColor="#757575"
                    android:textSize="11dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7" />
    </LinearLayout>
</FrameLayout>
