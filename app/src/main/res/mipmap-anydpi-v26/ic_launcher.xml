<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!-- লোগো পুরো ক্যানভাস জুড়ে থাকলে লঞ্চার মাঝের অংশ জুম করে কেটে দেখায়।
         inset দিয়ে লোগোকে নিরাপদ জায়গার ভেতরে আনা হলো (বড় চাইলে সংখ্যা কমান, ছোট চাইলে বাড়ান) -->
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="20%" />
    </foreground>
</adaptive-icon>
