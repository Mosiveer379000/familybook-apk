<resources>
    <!-- একটা সারি: লেবেল : ঘর * -->
    <style name="WizRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="WizLabel">
        <item name="android:layout_width">104dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#444444</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- ধাপ ২-এর লম্বা লেবেল (Strong Password, Primary Email) এক লাইনে ধরানোর জন্য -->
    <style name="WizLabelWide" parent="WizLabel">
        <item name="android:layout_width">124dp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WizColon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:text">:</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_wiz_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textColorHint">#BDBDBD</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizStar">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:text">*</item>
        <item name="android:textColor">#E53935</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizOptional">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:text">(Optional)</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
