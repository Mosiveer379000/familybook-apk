<resources>
    <!-- একটা সারি: লেবেল : ঘর * -->
    <style name="WizRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">top</item>
    </style>
    <!-- লেবেল: ধাপ ১-৫ সবখানে একই (14sp) -->
    <style name="WizLabel">
        <item name="android:layout_width">118dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#444444</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizLabelWide" parent="WizLabel" />
    <style name="WizColon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:text">:</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- ঘর: উচ্চতা বদলে wrap_content + minHeight, তাই নিচের দিক আর কাটবে না -->
    <style name="WizBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/bg_wiz_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textColorHint">#BDBDBD</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizStar">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:text">*</item>
        <item name="android:textColor">#E53935</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizOptional">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:text">(Optional)</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">12sp</item>
    </style>
    <!-- Step 3/4 শিরোনাম ও বর্ণনা -->
    <style name="WizHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#444444</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WizInfo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">12sp</item>
    </style>
    <!-- Back / Next / Skip / Register / Upload -->
    <style name="WizButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- আগের "C" (compact) নামগুলো যাতে অন্য কোথাও ভাঙে না: এখন সব মূল style-এর সমান -->
    <style name="WizRowC" parent="WizRow" />
    <style name="WizLabelC" parent="WizLabel" />
    <style name="WizColonC" parent="WizColon" />
    <style name="WizBoxC" parent="WizBox" />
    <style name="WizStarC" parent="WizStar" />
    <style name="WizOptionalC" parent="WizOptional" />
</resources>
